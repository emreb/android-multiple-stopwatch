<?xml version="1.0" encoding="utf-8"?>
<!-- Timing is tied to this device's clock, so it is neither backed up nor copied to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
