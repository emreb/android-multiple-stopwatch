<?xml version="1.0" encoding="utf-8"?>
<!-- Timing is tied to this device's clock, and the privacy policy promises that nothing kept by the
     app leaves the device, so neither it, the labels nor the history is backed up or copied to a
     new device. All three are kept in shared preferences. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
