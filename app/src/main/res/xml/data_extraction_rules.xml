<?xml version="1.0" encoding="utf-8"?>
<!-- Timing is tied to this device's clock, and the privacy policy promises that nothing kept by the
     app leaves the device, so neither it, the notes kept with it and with results, the labels, the
     history nor whether a rating has been asked for is backed up or copied to a new device. All of them are kept in shared preferences. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
